# ============================================================================
# Harness Director — 环境变量示例（只含空占位符，绝不提交真实凭证）
# 复制为 .env 后填入，.env 已被 Git 忽略。
# ============================================================================

# 火山方舟 Seedance API Key（开发环境用；正式桌面端存入 macOS Keychain，不落此文件）
ARK_API_KEY=

# 消费通道：agent_plan（Agent Plan）| platform（Platform）
# 默认 platform（实测：Seedance 1.0 模型仅支持 Platform；Agent Plan 返回 UnsupportedModel 且不会自动切换）
SEEDANCE_BILLING_MODE=

# Seedance 模型 ID（不写死，由设置页配置；留空则使用服务端默认/需在设置页填写）
SEEDANCE_MODEL=

# TOS 参考素材上传（可选；优先预签名 URL 或临时凭证，长期 AK/SK 不入桌面端）
TOS_PRESIGNED_URL=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_SECURITY_TOKEN=
TOS_ENDPOINT=
TOS_BUCKET=
TOS_REGION=

# 付费端到端测试（默认关闭；运行前须同时满足 RUN_PAID_E2E=1 与 CONFIRM_PAID_SEEDANCE=YES 双门禁）
RUN_PAID_E2E=
CONFIRM_PAID_SEEDANCE=
# 旧名 PAID_E2E_CONFIRM 兼容（=yes）
