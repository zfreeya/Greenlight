# 依赖与构建产物
node_modules
dist
src-tauri/target
src-tauri/gen

# 打包资源（体积巨大，由 scripts/prepare-resources.sh 从本机服务重新生成）
resources/node
resources/memory-core
resources/memory-proxy

# 系统与日志
.DS_Store
*.log
logs

# 编辑器
.vscode
.idea

# 移动端平台图标（桌面端 .app 用不到）
src-tauri/icons/android
src-tauri/icons/ios
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png

# 打包内嵌资源（体积大，prepare-resources.sh 本地生成，不进 git）
src-tauri/resources/node
src-tauri/resources/memory-core
src-tauri/resources/memory-proxy
src-tauri/resources/tools-server

# Playwright 测试产物
test-results/
playwright-report/
workspace/

# 凭证与敏感文件（绝不进 Git）
.env
.env.*.local
*.key
*.pem
credentials*.json

# Python sidecar 虚拟环境与缓存
.venv/
__pycache__/
*.pyc

# Director 生成引擎运行时数据库（缓存/任务生命周期，本地产物）
**/director/generation.db
**/director/generation.db-*
**/director/uploads.db
**/director/uploads.db-*
**/director/exports/
**/director/assets/seedance/