{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness",
  "version": "0.1.0",
  "identifier": "dev.harness.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": [
      "resources/node/bin/node",
      "resources/node/lib/*",
      "resources/memory-core/**/*",
      "resources/memory-proxy/**/*",
      "resources/tools-server/**/*",
      "resources/python-site-packages/**/*",
      "resources/config/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}